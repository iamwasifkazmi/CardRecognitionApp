# Google ML Kit Text Recognition — dynamic frameworks (embed FBLPromises, etc.).
# Open CardRecognitionApp.xcworkspace after pod install.
platform :ios, '18.0'

target 'CardRecognitionApp' do
  # Static: one Pods umbrella links all Google deps (avoids FBLPromises missing at link time).
  use_frameworks! :linkage => :static
  pod 'GoogleMLKit/TextRecognition', '~> 8.0'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '18.0'
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = ''
    end
  end

  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = '$(inherited)'
      end
    end
  end

  Dir.glob(File.join(installer.sandbox.root, 'Target Support Files', '**', '*.xcconfig')).each do |path|
    contents = File.read(path)
    patched = contents.gsub('EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64', 'EXCLUDED_ARCHS[sdk=iphonesimulator*] = ')
    File.write(path, patched) if patched != contents
  end
end
